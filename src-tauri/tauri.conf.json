{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "byteforge",
  "version": "0.1.0",
  "identifier": "com.kaanalper.byteforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ByteForge",
        "width": 1000,
        "height": 720,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNjA4RTUyNzM2MDdEM0UKUldRK2ZXQnpVbzVna1FFTWUwS09rdDJiYVRmZ0RRaFhhMEpYNGNBai9NOGFpVWhBbzBGUU1uL3QK",
      "endpoints": [
        "https://github.com/KaanAlper/ByteForge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
